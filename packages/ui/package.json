{
  "name": "@cloud-dog/ui",
  "description": "Reusable React UI components built on Cloud-Dog tokens and shell primitives.",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "author": "Cloud-Dog, Viewdeck Engineering Limited",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
