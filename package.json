{
  "name": "@cloud-dog/ui-platform",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20 <24",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier -w .",
    "e2e": "turbo run e2e",
    "a11y": "turbo run a11y",
    "test:public-payload": "node tools/verify-public-payload.mjs",
    "clean": "find . -name dist -type d -prune -exec rm -rf {} +",
    "packages:build": "turbo run build --filter=./packages/*"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "axe-core": "^4.10.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4",
    "vitest-axe": "^0.1.0",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "Apache-2.0"
}
